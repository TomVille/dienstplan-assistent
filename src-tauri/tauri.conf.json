{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dienstplan-Assistent",
  "version": "1.2.1",
  "identifier": "de.regiovision.dienstplan-assistent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dienstplan-Assistent",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MEVBM0MxMjQ2ODUzMzUKUldRMVUyZ2t3YU1PSlZjMVhjSHBpNC8xWWFpN1l1aldFd0YzTGl0K0dmY0lmcVRBZWc0VXJEaUYK",
      "endpoints": [
        "https://github.com/TomVille/dienstplan-assistent/releases/latest/download/latest.json"
      ]
    }
  }
}
