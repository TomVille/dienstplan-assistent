{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte des Hauptfensters",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "updater:default",
    "process:default",
    "process:allow-restart",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    { "identifier": "fs:scope", "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DESKTOP/**" }] },
    "opener:default"
  ]
}
